spring:
  datasource:
    url: jdbc:mysql://localhost:3306/uhheung_voca?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: root
    password: REPLACE_ME_LOCAL_DB_PASSWORD
    driver-class-name: com.mysql.cj.jdbc.Driver

# Generate with: openssl rand -base64 48
# Must be at least 32 bytes (HS256 requirement) — keep this file out of git.
jwt:
  secret: REPLACE_ME_BASE64_32BYTES_MIN
  access-token-validity-ms: 3600000          # 1 hour
  refresh-token-validity-ms: 1209600000      # 14 days

cors:
  allowed-origins: http://localhost:5173

# 부팅 시 ADMIN 계정 자동 생성 — 두 키가 모두 채워져 있고 해당 username 이 DB 에 없을 때만 동작.
# 비밀번호는 절대 git 에 커밋하지 말 것. application-local.yml 만 채워서 쓴다.
admin:
  bootstrap-username: admin
  bootstrap-password: REPLACE_ME_ADMIN_PASSWORD
  bootstrap-nickname: 관리자
